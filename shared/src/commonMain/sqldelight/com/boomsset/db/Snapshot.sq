import com.boomsset.domain.ValuationMode;

-- A snapshot of the user's holding state. **Immutable, append-only.** Each row is the complete
-- state at that point in time, not a delta.
--
-- The CHECK constraint bakes the mode-to-field correspondence directly into the schema -- so
-- data like "a QUOTED snapshot with no quantity" or "a MANUAL snapshot with no market value"
-- simply cannot be stored at the database level.
-- docs/domain.md notes that this kind of error is "silently miscalculated, not reported", so
-- here it's turned into a write failure instead.
CREATE TABLE snapshot (
    id               INTEGER PRIMARY KEY AUTOINCREMENT,
    asset_id         INTEGER NOT NULL REFERENCES asset(id),
    as_of            INTEGER NOT NULL,
    mode             TEXT AS ValuationMode NOT NULL,
    -- MANUAL only: market value in the asset's own currency, in minor units (cents)
    value_minor      INTEGER,
    -- QUOTED only: quantity, fixed-point integer with scale=8
    quantity_scaled  INTEGER,
    -- QUOTED only: which symbol this snapshot should use to fetch its price (still needed by
    -- historical snapshots even after a delisting converts the asset to MANUAL)
    quote_symbol     TEXT,
    -- Optional, applies to either mode: **total cost** in the asset's own currency (average
    -- cost is a derived value, not stored)
    cost_basis_minor INTEGER,
    recorded_at      INTEGER NOT NULL,

    CHECK (
        (mode = 'MANUAL' AND value_minor IS NOT NULL
                         AND quantity_scaled IS NULL AND quote_symbol IS NULL)
        OR
        (mode = 'QUOTED' AND quantity_scaled IS NOT NULL AND quote_symbol IS NOT NULL
                         AND value_minor IS NULL)
    )
);

CREATE INDEX snapshot_asset_asof ON snapshot(asset_id, as_of);

-- The core query for the carry-forward rule: for each asset, take the **most recent** snapshot
-- on or before T. No snapshot means the asset just doesn't appear (rather than being treated as
-- 0); an archived asset naturally goes to zero via its terminating zero-value snapshot.
selectLatestAsOfPerAsset:
SELECT s.* FROM snapshot s
WHERE s.as_of <= :asOf
  AND s.as_of = (
      SELECT MAX(s2.as_of) FROM snapshot s2
      WHERE s2.asset_id = s.asset_id AND s2.as_of <= :asOf
  )
  -- If there are multiple rows at the same point in time (a historical correction), take the
  -- one with the largest id, i.e. the most recently recorded
  AND s.id = (
      SELECT MAX(s3.id) FROM snapshot s3
      WHERE s3.asset_id = s.asset_id AND s3.as_of = s.as_of
  );

selectForAsset:
SELECT * FROM snapshot WHERE asset_id = ? ORDER BY as_of, id;

selectLatestForAsset:
SELECT * FROM snapshot WHERE asset_id = ? ORDER BY as_of DESC, id DESC LIMIT 1;

insertManual:
INSERT INTO snapshot(asset_id, as_of, mode, value_minor, cost_basis_minor, recorded_at)
VALUES (?, ?, 'MANUAL', ?, ?, ?);

insertQuoted:
INSERT INTO snapshot(asset_id, as_of, mode, quantity_scaled, quote_symbol, cost_basis_minor, recorded_at)
VALUES (?, ?, 'QUOTED', ?, ?, ?, ?);

-- Snapshots are immutable, there is no update. Correcting history = appending a new one.

-- Full table. The repository layer loads it all at once and computes derived values in memory
-- -- see PortfolioData's design trade-off notes.
selectAllSnapshots:
SELECT * FROM snapshot ORDER BY asset_id, as_of, id;
