-- Market quotes. **Public data, unrelated to the user.**
--
-- Refreshing on app open only writes here, never to snapshot -- otherwise opening the app ten
-- times a day would write ten holding records for every asset, and the snapshot table would
-- explode. See docs/domain.md "Quote != Snapshot".
--
-- The primary key is (symbol, as_of_day), so "only one row per symbol per day" is guaranteed by
-- the database; a daily upsert via INSERT OR REPLACE is enough, no need for the app layer to
-- check for duplicates.
CREATE TABLE quote (
    symbol      TEXT NOT NULL,
    -- ISO 'YYYY-MM-DD' (date in the user's local time zone). Stored as text so it stays
    -- human-readable while lexicographic order still matches chronological order.
    as_of_day   TEXT NOT NULL,
    -- scale-8 fixed-point unit price. Not cents! Low-priced stocks and tokens need more than
    -- 2 decimal places of precision.
    price_scaled INTEGER NOT NULL,
    currency    TEXT NOT NULL,
    fetched_at  INTEGER NOT NULL,
    PRIMARY KEY (symbol, as_of_day)
);

-- Carry-forward: fetch the most recent quote for a symbol on or before a given day.
-- When a price fetch fails, this is what falls back to a stale price instead of treating the
-- asset as worth 0.
selectLatestOnOrBefore:
SELECT * FROM quote
WHERE symbol = :symbol AND as_of_day <= :day
ORDER BY as_of_day DESC LIMIT 1;

selectLatestForSymbols:
SELECT q.* FROM quote q
WHERE q.as_of_day <= :day
  AND q.as_of_day = (
      SELECT MAX(q2.as_of_day) FROM quote q2
      WHERE q2.symbol = q.symbol AND q2.as_of_day <= :day
  );

upsert:
INSERT OR REPLACE INTO quote(symbol, as_of_day, price_scaled, currency, fetched_at)
VALUES (?, ?, ?, ?, ?);

selectAllSymbols:
SELECT DISTINCT symbol FROM quote;

selectAllQuotes:
SELECT * FROM quote ORDER BY symbol, as_of_day;
