-- Simple key-value settings table.
--
-- **One deviation from docs/stack.md: DataStore is not used here.**
-- Reason: right now we only need to store a single base-currency string, while DataStore would
-- pull in a new dependency + okio Path + per-platform path implementations, and its non-Android
-- targets are still officially marked experimental by Google. Paying that cost for one string
-- isn't worth it, and it would add extra iOS risk. Once there's a real batch of preferences
-- (theme, reminders, app-lock config), adopt DataStore then and this table can be migrated over.
CREATE TABLE settings (
    key   TEXT PRIMARY KEY NOT NULL,
    value TEXT NOT NULL
);

selectByKey:
SELECT value FROM settings WHERE key = ?;

selectAll:
SELECT * FROM settings;

upsert:
INSERT OR REPLACE INTO settings(key, value) VALUES (?, ?);
