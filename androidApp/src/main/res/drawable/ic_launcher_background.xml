<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer of the adaptive icon. Uses a shape rather than a PNG — a solid color has no
  need for bitmaps across five density buckets. The background layer must fill the entire 108dp
  canvas: the launcher clips it with its own mask, and leaving blank space would show edges under
  different OEM masks.

  **Solid color, not a gradient** — the foreground carves the gaps around the bars into
  transparency (see generate.py), and this layer is what shows through. With a gradient, the
  color in the gaps wouldn't match the full-bleed version (the one used on iOS).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ic_launcher_bg" />
</shape>
