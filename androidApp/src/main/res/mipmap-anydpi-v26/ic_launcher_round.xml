<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (Android 8.0+; this project's minSdk is 26, so this path is always taken).

  The foreground PNG is already inset to the guaranteed-visible circle of diameter 66/108 — the
  launcher's mask shape is up to the OEM (circle / square / squircle / teardrop), and without
  the inset, the bar that pokes outside the ring would get clipped. The scaling is computed from
  CONTENT_R in adaptive_foreground() in tools/appicon/generate.py.

  monochrome is the Android 13+ themed icon (tinted to match the wallpaper). The system only uses
  this drawable's **alpha channel** as a silhouette, so the colored foreground can be reused
  directly — its alpha is exactly the shape of "allocation ring + three bars," and the gaps around
  the bars are truly transparent, so the "breaking out of the ring" motif still reads under the
  themed icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
