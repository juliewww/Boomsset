<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose manages the theme itself, so this only needs to be a host theme — but the
      **splash screen must be configured here**.

      The Android 12+ system splash screen is automatic: it takes `android:icon` as the icon and
      `android:windowSplashScreenBackground` as the background (API 31+). **If not configured**,
      it falls back to `windowBackground`, and `Theme.Material.Light`'s windowBackground is the
      platform's light gray — neither our warm background nor **dark-mode aware** (dark mode would
      briefly flash light gray before switching to the dark UI).

      So both need to be provided:
      * `windowBackground` — covers below API 31, and also avoids a flash of the platform color
        in the frame before the splash screen appears
      * `windowSplashScreenBackground` (in values-v31/) — the splash background for API 31+

      The color is `@color/splash_bg`, matching Theme.kt's `surface`, with **light/dark variants
      in values/ and values-night/'s colors.xml** — so the splash screen and the first screen
      after launch are continuous, with no color jump.
    -->
    <style name="Theme.Boomsset" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
