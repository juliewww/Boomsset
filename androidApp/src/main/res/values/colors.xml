<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Color of the icon's background layer. **Must match FIELD in tools/appicon/generate.py** —
      the adaptive foreground carves the gaps around the bars into transparency, and this layer
      is what shows through. If the two are out of sync, the gaps will show a mismatched-color
      outline. validate.py checks this.
    -->
    <color name="ic_launcher_bg">#FFEFF4</color>

    <!--
      Background color of the system splash screen. **Must match Theme.kt's LightScheme.surface**,
      otherwise there's a color jump between the splash screen and the first screen after launch.
      The dark-mode counterpart is in values-night/colors.xml.
    -->
    <color name="splash_bg">#FEF9F4</color>
</resources>
